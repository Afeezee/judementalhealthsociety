# Copy to .env.local and fill in real values.
# .env.local is gitignored via ".env*" in .gitignore.

# --- Database (Neon Postgres) -------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# --- Clerk auth (admin dashboard only) ----------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin

# --- AI Mental Health Companion (Groq — Llama 3.3 70B) ------------
GROQ_API=gsk_xxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# --- Writing Competition submission form (Sculptform) -------------
# The 2026 form URL. Update per year — falls back to the constant in
# src/lib/site-settings.ts (COMPETITION.submissionUrl) if unset.
NEXT_PUBLIC_SCULPTFORM_URL=https://www.sculptform.live/f/31NiLd0fbuJU
